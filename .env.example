# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=sso_user
DB_PASSWORD=sso_password
DB_NAME=sso_db

# Security Keys (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Service Ports
AUTH_SERVICE_PORT=8080
PROFILE_SERVICE_PORT=8081
BILLING_SERVICE_PORT=8082

# Service URLs (used for redirects)
AUTH_SERVICE_URL=http://localhost:8080
PROFILE_SERVICE_URL=http://localhost:8081
BILLING_SERVICE_URL=http://localhost:8082

# Internal service URLs (for server-to-server communication within Docker network)
AUTH_SERVICE_INTERNAL_URL=http://auth_service:8080

# Keycloak Configuration
# Internal URL (for server-to-server within Docker network)
KEYCLOAK_URL=http://keycloak:8090
# Browser URL (for user redirects)
KEYCLOAK_BROWSER_URL=http://localhost:8090
KEYCLOAK_REALM=micro-dashboard-sso
KEYCLOAK_CLIENT_ID=auth-service
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_AFTER_CREATING_CLIENT
OIDC_ENABLED=true


